{"cells":[{"cell_type":"markdown","metadata":{},"source":["# Blog 27 — Representation Learning"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import torch\n","encoder=torch.nn.Linear(6,2); decoder=torch.nn.Linear(2,6)\n","x=torch.randn(4,6); z=encoder(x); reconstruction=decoder(z)\n","print('input:',x.shape,'representation:',z.shape,'reconstruction:',reconstruction.shape)"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"}},"nbformat":4,"nbformat_minor":5}
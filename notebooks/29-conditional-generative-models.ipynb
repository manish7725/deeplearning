{"cells":[{"cell_type":"markdown","metadata":{},"source":["# Blog 29 — Conditional Generative Models"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import torch\n","noise=torch.randn(1,4); condition=torch.tensor([[1.,0.]])\n","generator=torch.nn.Linear(6,8); generated=generator(torch.cat([noise,condition],dim=1))\n","print(generated.shape)"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"}},"nbformat":4,"nbformat_minor":5}
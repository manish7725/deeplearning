{"cells":[{"cell_type":"markdown","metadata":{},"source":["# Blog 20 — Build a Tiny Neural Network From Scratch"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import numpy as np\n","x=np.array([1.,2.,3.,4.]); y=np.array([3.,5.,7.,9.]); w=b=0.; lr=.01\n","for _ in range(2000):\n","    p=w*x+b; e=p-y; loss=np.mean(e**2)\n","    w-=lr*np.mean(2*e*x); b-=lr*np.mean(2*e)\n","print(w,b,loss)"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"}},"nbformat":4,"nbformat_minor":5}
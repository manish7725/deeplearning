{"cells":[{"cell_type":"markdown","metadata":{},"source":["# Blog 10 — Backpropagation"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import torch\n","x=torch.tensor(2.,requires_grad=True); w=torch.tensor(3.,requires_grad=True)\n","y=(w*x)**2; y.backward()\n","print('loss:',y.item(),'dL/dw:',w.grad.item(),'dL/dx:',x.grad.item())"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"}},"nbformat":4,"nbformat_minor":5}
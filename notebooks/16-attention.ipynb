{"cells":[{"cell_type":"markdown","metadata":{},"source":["# Blog 16 — Attention"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import torch\n","Q=torch.tensor([[1.,0.],[0.,1.]])\n","K=Q.clone(); V=torch.tensor([[10.,0.],[0.,20.]])\n","scores=Q@K.T/(2**0.5); weights=torch.softmax(scores,dim=-1)\n","print('weights:',weights); print('output:',weights@V)"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"}},"nbformat":4,"nbformat_minor":5}